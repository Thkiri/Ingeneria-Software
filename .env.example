# =========================================================================
# TecniMotor Sur Ltda. — Plantilla de Variables de Entorno (.env.example)
# =========================================================================
# Instrucciones:
# 1. En desarrollo local / demostración (Evaluación 3) NO es necesario crear
#    un archivo .env: el sistema arranca automáticamente con SQLite (db.sqlite3).
# 2. Para preproducción o conexión a MySQL 8.0 (Evaluación 4 / Despliegue),
#    copiar este archivo como `.env` y completar las credenciales reales.
# =========================================================================

# --- Seguridad y Entorno Django ---
DJANGO_SECRET_KEY=reemplazar-por-clave-secreta-segura-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Motor de Base de Datos (sqlite | mysql) ---
# Dejar en 'sqlite' para usar Backend/db.sqlite3 local.
# Cambiar a 'mysql' para conectar con el esquema docs/tecnimotor_sur_v3.sql.
DB_ENGINE=sqlite

# --- Credenciales MySQL 8.0+ (Solo requeridas si DB_ENGINE=mysql) ---
DB_NAME=tecnimotor_sur
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Configuración Frontend (Vite / React) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api

